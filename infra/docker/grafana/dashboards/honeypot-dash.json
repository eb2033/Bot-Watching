      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Sources of Alerts",
          "description": "Utilises the enriched information from logged IPs to geo-locate the source IPs.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "honeypot-postgres"
                      },
                      "spec": {
                        "dataset": "honeypot",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\r\n  ie.latitude,\r\n  ie.longitude,\r\n  ie.country,\r\n  ie.city,\r\n  count(a.id) AS alert_count\r\nFROM ip_enrichment ie\r\nJOIN sessions s ON s.src_ip = ie.src_ip\r\nJOIN alerts a ON a.session_id = s.session_id\r\nWHERE ie.latitude IS NOT NULL\r\nGROUP BY ie.latitude, ie.longitude, ie.country, ie.city",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [
                                {
                                  "name": "src_ip",
                                  "type": "functionParameter"
                                }
                              ],
                              "type": "function"
                            },
                            {
                              "parameters": [
                                {
                                  "name": "asn",
                                  "type": "functionParameter"
                                }
                              ],
                              "type": "function"
                            },
                            {
                              "parameters": [
                                {
                                  "name": "country",
                                  "type": "functionParameter"
                                }
                              ],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        },
                        "table": "ip_enrichment"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
