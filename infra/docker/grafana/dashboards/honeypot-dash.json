      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Alerts over time",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "honeypot-postgres"
                      },
                      "spec": {
                        "dataset": "honeypot",
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "SELECT\r\n  $__timeGroup(timestamp, '$__interval') AS \"time\",\r\n  count(*) AS \"Alerts\"\r\nFROM alerts\r\nWHERE $__timeFilter(timestamp)\r\nGROUP BY 1\r\nORDER BY 1",
                        "sql": {
                          "columns": [
                            {
                              "alias": "\"time\"",
                              "parameters": [
                                {
                                  "name": "\"timestamp\"",
                                  "type": "functionParameter"
                                }
                              ],
                              "type": "function"
                            },
                            {
                              "name": "COUNT",
                              "parameters": [
                                {
                                  "name": "id",
                                  "type": "functionParameter"
                                }
                              ],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "name": "\"timestamp\"",
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50,
                          "whereJsonTree": {
                            "id": "bb88a989-0123-4456-b89a-b19f910bbbbf",
                            "type": "group"
                          }
                        },
                        "table": "alerts"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.1.1",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [],
                  "fields": "/.*/",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "auto",
                "wideLayout": true
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds",
                    "fixedColor": "#ad46ff"
                  },
                  "noValue": "N/A",
                  "fieldMinMax": false
                },
                "overrides": []
              }
            }
          }
        }
