                      },
                      "spec": {
                        "dataset": "honeypot",
                        "editorMode": "builder",
                        "format": "table",
                        "rawSql": "SELECT COUNT(severity) AS \"High Severity\" FROM alerts WHERE severity = 'High' LIMIT 50 ",
