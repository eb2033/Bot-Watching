# --- Database ---
# Used when running the engine outside Docker. Under docker compose the engine's
# DATABASE_URL is built from infra/docker/.env instead (see docker-compose.yml).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/honeypot?sslmode=require
# 1 = log every SQL statement with bound parameters. Local debugging only: it
# writes attacker-supplied credentials into the logs.
SQLALCHEMY_DEBUG=0

# --- Engine (local-file listener; see engine/main.py) ---
COWRIE_LOG_PATH=/var/log/cowrie/cowrie.json
LISTENER_BATCH_SIZE=5
LISTENER_POLL_INTERVAL_SECONDS=2
LOG_LEVEL=INFO

# --- AWS ---
# Not read by any code yet (the SQS/S3 listener isn't implemented). Credentials
# deliberately have no entry here: on EC2/ECS, use an IAM instance/task role,
# which boto3 picks up automatically - never static access keys in .env.
# AWS_REGION=eu-west-1
# SQS_QUEUE_URL=
# S3_BUCKET_NAME=
