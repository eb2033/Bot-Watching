# --- AWS (target architecture only — not read by any code yet) ---
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SQS_QUEUE_URL=
S3_BUCKET_NAME=

# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/honeypot

# --- Engine (local-file listener; see engine/main.py) ---
COWRIE_LOG_PATH=/var/log/cowrie/cowrie.json
LISTENER_BATCH_SIZE=5
LISTENER_POLL_INTERVAL_SECONDS=2

# --- Engine (aspirational — not read by any code yet) ---
POLL_INTERVAL_SECONDS=10
LOG_LEVEL=INFO

